table fact_sales
	lineageTag: 9eaf94b4-8db1-4a01-a553-e8c4359c34eb

	measure Revenue = SUM ( fact_sales[recognized_revenue] )
		formatString: #,0
		displayFolder: 1 Revenue
		lineageTag: bfe74fd2-5e65-4726-9484-0eee618bf7b4

	measure 'Sales all status' = SUM ( fact_sales[net_amount] )
		formatString: #,0
		displayFolder: 1 Revenue
		lineageTag: b843b83b-672b-4904-a321-77321ae775ed

	measure 'Promo revenue' = CALCULATE ( [Revenue], dim_promotion[has_promotion] = TRUE () )
		formatString: #,0
		displayFolder: 1 Revenue
		lineageTag: 241e9d65-b81d-4c18-a3fd-9a549e83d05c

	measure 'Promo share' = DIVIDE ( [Promo revenue], [Revenue] )
		formatString: 0.0%
		displayFolder: 1 Revenue
		lineageTag: 50b78ecb-4350-4b88-aa13-2455d2868292

	measure 'Revenue per day' = DIVIDE ( [Revenue], [Days] )
		formatString: #,0
		displayFolder: 1 Revenue
		lineageTag: 0c9a81fc-dded-4c31-b997-d28b6b1e6f9d

	measure Orders = DISTINCTCOUNT ( fact_sales[order_id] )
		formatString: #,0
		displayFolder: 2 Orders
		lineageTag: e86434aa-8463-4bcb-a583-322199ec6583

	measure 'Revenue orders' = CALCULATE ( [Orders], dim_order_status[counts_as_revenue] = TRUE () )
		formatString: #,0
		displayFolder: 2 Orders
		lineageTag: b68892ac-2b71-40cd-824c-0e1b1f61c8d3

	measure 'Cancelled orders' = CALCULATE ( [Orders], dim_order_status[status_name] = "cancelled" )
		formatString: #,0
		displayFolder: 2 Orders
		lineageTag: 55a035b1-451e-4976-82da-ab9816e44365

	measure 'Cancel rate' = DIVIDE ( [Cancelled orders], [Orders] )
		formatString: 0.00%
		displayFolder: 2 Orders
		lineageTag: 44385c8a-1075-41e7-896c-81232ee9246b

	measure Conversion = DIVIDE ( [Revenue orders], [Orders] )
		formatString: 0.00%
		displayFolder: 2 Orders
		lineageTag: d16f6b3b-2cb5-49cc-ad85-1b4917ac56c7

	measure AOV = DIVIDE ( [Revenue], [Revenue orders] )
		formatString: #,0.00
		displayFolder: 2 Orders
		lineageTag: d9aefb3a-b6f2-4ba3-a0cb-5aa656d0b072

	measure Days =
			VAR FirstKey = CALCULATE ( MIN ( fact_sales[order_date_key] ), REMOVEFILTERS () )
			VAR LastKey = CALCULATE ( MAX ( fact_sales[order_date_key] ), REMOVEFILTERS () )
			RETURN
			    COUNTROWS ( FILTER ( dim_date, dim_date[date_key] >= FirstKey && dim_date[date_key] <= LastKey ) )
		formatString: #,0
		displayFolder: 2 Orders
		lineageTag: cc5107cb-86df-491a-b563-65b71a3e09bc

	measure 'Orders per day' = DIVIDE ( [Revenue orders], [Days] )
		formatString: #,0.00
		displayFolder: 2 Orders
		lineageTag: 5f436ec4-4b20-48f2-8f13-f01d91bd4286

	measure 'Units sold' = CALCULATE ( SUM ( fact_sales[quantity] ), fact_sales[recognized_revenue] > 0 )
		formatString: #,0
		displayFolder: 3 Products
		lineageTag: edf64401-3465-4b00-a9dd-f86953cc9392

	measure 'Refund rate' = DIVIDE ( SUM ( fact_sales[refunded_quantity] ), SUM ( fact_sales[quantity] ) )
		formatString: 0.00%
		displayFolder: 3 Products
		lineageTag: 3b5a1dba-6e9c-4b74-a185-d86ab7732301

	measure 'Revenue share' = DIVIDE ( [Revenue], CALCULATE ( [Revenue], ALLSELECTED ( dim_product[price_band] ) ) )
		formatString: 0.0%
		displayFolder: 3 Products
		lineageTag: 843973ab-8c59-4fe3-9226-bec5840d864a

	measure 'Units share' = DIVIDE ( [Units sold], CALCULATE ( [Units sold], ALLSELECTED ( dim_product[price_band] ) ) )
		formatString: 0.0%
		displayFolder: 3 Products
		lineageTag: 5a5ed9af-61ef-4f90-9939-f8af75a94f37

	measure 'Revenue LY' =
			VAR FirstKey = CALCULATE ( MIN ( fact_sales[order_date_key] ), REMOVEFILTERS () )
			VAR LastKey = CALCULATE ( MAX ( fact_sales[order_date_key] ), REMOVEFILTERS () )
			VAR DataStart = DATE ( INT ( FirstKey / 10000 ), MOD ( INT ( FirstKey / 100 ), 100 ), MOD ( FirstKey, 100 ) )
			VAR DataEnd = DATE ( INT ( LastKey / 10000 ), MOD ( INT ( LastKey / 100 ), 100 ), MOD ( LastKey, 100 ) )
			VAR SelStart = MAX ( MIN ( dim_date[date_day] ), DataStart )
			VAR SelEnd = MIN ( MAX ( dim_date[date_day] ), DataEnd )
			VAR PrevStart = EDATE ( SelStart, -12 )
			VAR PrevEnd = EDATE ( SelEnd, -12 )
			RETURN
			    IF (
			        SelStart <= SelEnd && PrevStart >= DataStart,
			        CALCULATE ( [Revenue], DATESBETWEEN ( dim_date[date_day], PrevStart, PrevEnd ) )
			    )
		formatString: #,0
		displayFolder: 4 Time comparison
		lineageTag: 075cf600-8585-4b43-a12b-593be2429bd9

	measure 'Revenue vs LY' = DIVIDE ( [Revenue] - [Revenue LY], [Revenue LY] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 4 Time comparison
		lineageTag: e0484ec5-524c-46e5-9aa2-fe7087e5288d

	measure 'Revenue PP' =
			VAR FirstKey = CALCULATE ( MIN ( fact_sales[order_date_key] ), REMOVEFILTERS () )
			VAR LastKey = CALCULATE ( MAX ( fact_sales[order_date_key] ), REMOVEFILTERS () )
			VAR DataStart = DATE ( INT ( FirstKey / 10000 ), MOD ( INT ( FirstKey / 100 ), 100 ), MOD ( FirstKey, 100 ) )
			VAR DataEnd = DATE ( INT ( LastKey / 10000 ), MOD ( INT ( LastKey / 100 ), 100 ), MOD ( LastKey, 100 ) )
			VAR SelStart = MAX ( MIN ( dim_date[date_day] ), DataStart )
			VAR SelEnd = MIN ( MAX ( dim_date[date_day] ), DataEnd )
			VAR NumDays = INT ( SelEnd - SelStart ) + 1
			VAR PrevStart = SelStart - NumDays
			VAR PrevEnd = SelStart - 1
			RETURN
			    IF (
			        SelStart <= SelEnd && PrevStart >= DataStart,
			        CALCULATE ( [Revenue], DATESBETWEEN ( dim_date[date_day], PrevStart, PrevEnd ) )
			    )
		formatString: #,0
		displayFolder: 4 Time comparison
		lineageTag: 3f806345-cdda-45f5-8013-871879e9bbd0

	measure 'Revenue vs PP' = DIVIDE ( [Revenue] - [Revenue PP], [Revenue PP] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 4 Time comparison
		lineageTag: c0e05f54-da5a-4af8-8ab9-55902325bc9d

