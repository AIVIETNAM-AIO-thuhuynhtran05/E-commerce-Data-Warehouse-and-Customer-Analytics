table mart_product_abc
	lineageTag: ac10f3f7-2996-4d80-ab33-ef5a891eeb1c

	measure 'ABC revenue' = SUM ( mart_product_abc[recognized_revenue] )
		formatString: #,0
		displayFolder: 5 ABC
		lineageTag: 45ad8d7e-3203-4d42-8dbe-72ae4f97ade4

	measure 'ABC products' = COUNTROWS ( mart_product_abc )
		formatString: #,0
		displayFolder: 5 ABC
		lineageTag: d5bd5378-9dd3-4941-bb2d-bd70ad0c89e6

	measure 'ABC revenue share' = DIVIDE ( [ABC revenue], CALCULATE ( [ABC revenue], ALLEXCEPT ( mart_product_abc, mart_product_abc[year] ) ) )
		formatString: 0.0%
		displayFolder: 5 ABC
		lineageTag: 07c7efb9-b497-437d-9a30-5721b67922ac

	measure 'Cumulative share' = MAX ( mart_product_abc[cumulative_share] )
		formatString: 0.0%
		displayFolder: 5 ABC
		lineageTag: 2e7313ef-5122-4797-bb05-e5a01b7cc00f

	measure 'Top 20% share' =
			VAR Products = CALCULATE ( COUNTROWS ( mart_product_abc ), ALLEXCEPT ( mart_product_abc, mart_product_abc[year] ) )
			RETURN
			    CALCULATE (
			        MAX ( mart_product_abc[cumulative_share] ),
			        ALLEXCEPT ( mart_product_abc, mart_product_abc[year] ),
			        mart_product_abc[revenue_rank] <= Products * 0.2
			    )
		formatString: 0.0%
		displayFolder: 5 ABC
		lineageTag: 27fe807d-32f1-4d17-ba93-7f9567df0b68

	measure 'A products low stock' = COUNTROWS ( FILTER ( mart_product_abc, mart_product_abc[abc_class] = "A" && mart_product_abc[warehouses_below_reorder] > 0 ) )
		formatString: #,0
		displayFolder: 5 ABC
		lineageTag: f5cb10de-529b-488d-bf39-5528329987b0

	measure 'A products low everywhere' = COUNTROWS ( FILTER ( mart_product_abc, mart_product_abc[abc_class] = "A" && mart_product_abc[warehouse_count] > 0 && mart_product_abc[warehouses_below_reorder] = mart_product_abc[warehouse_count] ) )
		formatString: #,0
		displayFolder: 5 ABC
		lineageTag: dbbb02f7-5fd2-41c6-866e-2610fbfbf6e6

