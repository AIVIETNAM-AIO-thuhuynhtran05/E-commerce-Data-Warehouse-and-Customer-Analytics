table mart_inventory_warehouse
	lineageTag: b5194c1b-99e2-430b-8723-aeab8261b5c0

	measure 'Stock available' = SUM ( mart_inventory_warehouse[quantity_available] )
		formatString: #,0
		displayFolder: 6 Inventory
		lineageTag: faaeaefd-b758-4f33-8ab4-f1c56df1c9d6

	measure 'Stock reserved' = SUM ( mart_inventory_warehouse[quantity_reserved] )
		formatString: #,0
		displayFolder: 6 Inventory
		lineageTag: 8aa215dc-1958-4fe1-9134-25e947c7f1d5

	measure 'Stock pairs' = COUNTROWS ( mart_inventory_warehouse )
		formatString: #,0
		displayFolder: 6 Inventory
		lineageTag: 3df8b0b4-42bb-4b11-975f-2b2acaf26a77

	measure 'Reorder pairs' = CALCULATE ( COUNTROWS ( mart_inventory_warehouse ), mart_inventory_warehouse[needs_reorder] = TRUE () )
		formatString: #,0
		displayFolder: 6 Inventory
		lineageTag: 27ffc085-2822-41e9-a202-73accc240abd

	measure 'Reorder rate' = DIVIDE ( [Reorder pairs], [Stock pairs] )
		formatString: 0.0%
		displayFolder: 6 Inventory
		lineageTag: b0a1091b-5728-4963-87dc-d95079ebbac1

	measure 'Out of stock pairs' = CALCULATE ( COUNTROWS ( mart_inventory_warehouse ), mart_inventory_warehouse[is_out_of_stock] = TRUE () )
		formatString: #,0
		displayFolder: 6 Inventory
		lineageTag: 96c5edd8-f651-4f5d-b829-4c01de3ae369

	measure 'Stocked products' = DISTINCTCOUNT ( mart_inventory_warehouse[product_key] )
		formatString: #,0
		displayFolder: 6 Inventory
		lineageTag: 26b1c00c-8013-406b-933f-76585f193a37

	measure 'Products without stock record' = COUNTROWS ( EXCEPT ( ALL ( dim_product[product_key] ), ALL ( mart_inventory_warehouse[product_key] ) ) )
		formatString: #,0
		displayFolder: 6 Inventory
		lineageTag: 25733265-8b6c-4013-8618-7e877f1ae3ae

