table mart_returns
	lineageTag: de2a6c33-a33a-4e8c-a9c6-0c41e75c0f50

	measure 'Return requests' = COUNTROWS ( mart_returns )
		formatString: #,0
		displayFolder: 7 Returns
		lineageTag: 88f26174-8a05-460c-93d0-19591c45bd61

	measure 'Returned units' = SUM ( mart_returns[returned_quantity] )
		formatString: #,0
		displayFolder: 7 Returns
		lineageTag: 964d7dd2-7b66-4be3-a52d-e468fe3aa3ff

	measure 'Refunded amount' = SUM ( mart_returns[refunded_amount] )
		formatString: #,0
		displayFolder: 7 Returns
		lineageTag: 4c69db21-95c4-4c62-837e-375c5258e6c9

	measure 'Seller reason share' = DIVIDE ( CALCULATE ( [Return requests], mart_returns[reason_group] = "seller" ), [Return requests] )
		formatString: 0.0%
		displayFolder: 7 Returns
		lineageTag: 42845ff1-8e8f-49d6-ad76-859bac3638dc

	measure 'Rejection rate' = DIVIDE ( CALCULATE ( [Return requests], mart_returns[return_status] = "rejected" ), CALCULATE ( [Return requests], mart_returns[is_processed] = TRUE () ) )
		formatString: 0.0%
		displayFolder: 7 Returns
		lineageTag: 13e4dcb0-7b52-4ef4-a769-8e6782d86bc6

	measure 'Avg days to process' = AVERAGE ( mart_returns[days_to_process] )
		formatString: 0.0
		displayFolder: 7 Returns
		lineageTag: 1fbf2bec-25d0-4063-8a08-cf89118895bb

